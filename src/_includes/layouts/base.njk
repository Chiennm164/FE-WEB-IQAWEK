{#- Khung chung của mọi trang: <head>, header, menu mobile, footer, script. Markup giữ nguyên từ template của site cũ. -#}
{%- set t = site[lang] -%}
{%- set isHome = layout == "home.njk" -%}
{%- set currentCatId = categoryId or (listPage.cat.id if listPage else null) -%}
{%- set currentSection = (currentCatId | catPath)[0] if currentCatId else null -%}
{%- set currentCat = currentCatId | category if currentCatId else null -%}
{#- Tiêu đề: trang chủ dùng meta.siteTitle; trang khác "<tên trang> | <brand>".
    Sản phẩm chỉ có mã model (vd. "C558") hoặc trùng tên danh mục thì thêm nhóm sản phẩm;
    trang danh sách từ trang 2 thêm số trang. -#}
{%- set pageTitle = title -%}
{%- if layout == "product.njk" and currentCatId and (not (" " in title) or (title | lower) == (currentCat.name | lower)) -%}
  {%- set pageTitle = title + " – " + (currentCatId | catPath)[1].name -%}
{%- endif -%}
{%- if listPage and listPage.page > 1 -%}
  {%- set pageTitle = pageTitle + " – " + t.meta.page + " " + listPage.page -%}
{%- endif -%}
{%- set fullTitle = t.meta.siteTitle if isHome else pageTitle + " | " + site.brand -%}
{#- Meta description: front matter "description"; sản phẩm chưa có thì "<brand> <tên>. <mô tả chung>";
    trang danh sách theo mẫu meta.listDescription -#}
{%- if layout == "product.njk" and not description -%}
  {%- set metaDesc = site.brand + " " + pageTitle + ". " + t.meta.description -%}
{%- elif listPage -%}
  {%- set metaDesc = t.meta.listDescription[listPage.cat.type] | replace("{name}", listPage.cat.name) -%}
  {%- if listPage.page > 1 %}{% set metaDesc = t.meta.page + " " + listPage.page + " – " + metaDesc %}{% endif -%}
{%- else -%}
  {%- set metaDesc = description or t.meta.description -%}
{%- endif -%}
{%- set metaDesc = metaDesc | metaDescription -%}
{#- Ảnh khi chia sẻ link (Facebook, Zalo…): ảnh sản phẩm, ảnh đầu bài tin, banner danh mục, mặc định site.ogImage -#}
{%- if images and images.length -%}
  {%- set shareImage = images[0] -%}
{%- elif layout == "news.njk" -%}
  {%- set shareImage = (content | firstImage) or thumb -%}
{%- elif currentCatId -%}
  {%- set shareImage = thumb or (currentCatId | catBanner).banner -%}
{%- endif -%}
{%- set shareImage = shareImage or site.ogImage -%}
<!doctype html>
<html lang="{{ t.meta.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="{{ site.favicon }}"/>
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ metaDesc }}">
{% include "partials/seo.njk" %}
<link rel="stylesheet" type="text/css" href="/assets/iconfont/iconfont-common.css">
{#- Trang chủ dùng index.css thay main.css và không cần iconfont-pages -#}
{%- if not isHome %}
<link rel="stylesheet" type="text/css" href="/assets/iconfont/iconfont-pages.css">
{%- endif %}
<link href="/assets/css/animate.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/swiper.min.css" media="screen">
<link href="/assets/css/reset.css" rel="stylesheet">
{%- if not isHome %}
<link href="/assets/css/main.css" rel="stylesheet">
{%- endif %}
{%- for href in css %}
<link href="{{ href }}" rel="stylesheet">
{%- endfor %}
</head>
<body>
<header>
<div class="wrap">
<a href="javascript:;" class="menu-trigger">
<span></span>
<span></span>
<span></span>
</a>
<a href="/{{ lang }}/" class="logo"><img src="/assets/images/logo.png" alt="{{ site.brand }}"></a>
<div class="header-right white">
<div class="header-menu">
<ul>
<li class="">
<a href="/{{ lang }}/" title="{{ t.header.home }}">{{ t.header.home }}</a>
</li>
{%- for top in lang | topCats %}
<li class="{{ 'current' if currentSection and currentSection.id == top.id }}">
<a href="{{ top.url }}" title="{{ top.name }}">{{ top.name }}</a>
{%- set children = top.id | subCats %}
{%- if children.length %}
<ul>
{%- for child in children %}
<li>
<a href="{{ child.url }}" title="{{ child.name }}">{{ child.name }}</a>
</li>
{%- endfor %}
</ul>
{%- endif %}
</li>
{%- endfor %}
</ul>
</div>
<div class="header-tools">
<div class="header-search">
<a href="javascript:;"><i class="icon iconfont icon-sousuo_o"></i></a>
</div>
</div>
</div>
</div>
</header>
<section class="clear"></section>
<section class="search-box">
<a href="javascript:;" class="close"><i class="icon iconfont icon-guanbi"></i></a>
<form method="get" action="/{{ lang }}/search/">
<input name="q" type="text" placeholder="{{ t.header.searchPlaceholder }}" autocomplete="off" />
<button type="submit"><i class="icon iconfont icon-sousuo_o"></i></button>
</form>
</section>
<section class="clear"></section>
<section class="overlay"></section>
<section class="subnav">
<h2><i class="icon iconfont icon-fenlei1"></i> {{ t.header.menu }}</h2>
<div class="menu-box">
<ul>
{%- for top in lang | topCats %}
{%- set children = top.id | subCats %}
<li class="{{ 'current' if currentSection and currentSection.id == top.id }}">
{%- if children.length %}
<a href="javascript:;" title="{{ top.name }}" class="nav-a">{{ top.name }} <i class="right icon iconfont icon-zengjia"></i></a>
<ul>
{%- for child in children %}
<li>
<a href="{{ child.url }}" title="{{ child.name }}">{{ child.name }}</a>
</li>
{%- endfor %}
</ul>
{%- else %}
<a href="{{ top.url }}" title="{{ top.name }}">{{ top.name }}</a>
{%- endif %}
</li>
{%- endfor %}
</ul>
</div>
<h2><i class="icon iconfont icon-sousuo_o"></i> {{ t.header.search }}</h2>
<div class="zoom-box">
<form method="get" action="/{{ lang }}/search/">
<input name="q" type="text" placeholder="{{ t.header.searchShort }}" autocomplete="off" />
<button type="submit"><i class="icon iconfont icon-sousuo_o"></i></button>
</form>
</div>
</section>
<section class="clear"></section>
{% block main %}{{ content | safe }}{% endblock %}
<section class="clear"></section>
<footer class="wow fadeInUp" data-wow-delay="0.15s">
<div class="mapBg"><img src="/assets/images/footer-map.png" alt="" loading="lazy"></div>
<div class="menuBox">
<div class="l"><img src="/assets/images/footer-left.png" alt="" loading="lazy"></div>
<div class="c wrap">
<div class="navBox">
<div class="linkBox">
<h2>{{ t.footer.links }}</h2>
<ul>
{%- for top in lang | topCats %}
<li>
<a href="{{ top.url }}" title="{{ top.name }}"><i class="icon iconfont icon-arrowRight"></i>{{ top.name }}</a>
</li>
{%- endfor %}
</ul>
</div>
<div class="contactBox">
<h2>{{ t.footer.contact }}</h2>
<ul>{{ t.footer.contactHtml | safe }}</ul>
</div>
<div class="shareBox">
<h2>{{ t.footer.share }}</h2>
<ul>
{%- for link in t.footer.social %}
<li>
<a href="{{ link.url }}"><i class="icon iconfont {{ link.icon }}"></i><span>{{ link.label }}</span></a>
</li>
{%- endfor %}
</ul>
</div>
</div>
<div class="copyBox">
<div class="left">{{ t.footer.copyrightLeft | safe }}</div>
{%- if t.footer.copyrightRight %}
<div class="right">{{ t.footer.copyrightRight | safe }}</div>
{%- endif %}
</div>
</div>
<div class="r"><img src="/assets/images/footer-right.png" alt="" loading="lazy"></div>
</div>
</footer>
{% include "partials/zalo-chat.njk" %}
{#- Script đặt cuối trang để không chặn việc hiển thị nội dung; mọi script inline đều nằm sau các dòng này -#}
<script type="text/javascript" src="/assets/js/wow.min.js"></script>
<script type="text/javascript" src="/assets/js/jquery-1.11.1.min.js"></script>
<script type="text/javascript" src="/assets/js/swiper.min.js"></script>
<script type="text/javascript" src="/assets/js/main.js"></script>
{%- for src in js %}
<script type="text/javascript" src="{{ src }}"></script>
{%- endfor %}
<script>
new WOW().init();
</script>
{%- if inlineScript %}
<script>
{{ inlineScript | safe }}
</script>
{%- endif %}
{% block scripts %}{% endblock %}
<script>
window.SITE_FORM = {{ { endpoint: site.formEndpoint, mailto: site.contactEmail, thanks: t.form.thanks, mail: t.form.mailtoNotice, required: t.form.required } | dump | safe }};
</script>
<script type="text/javascript" src="/assets/js/forms.js"></script>
</body>
</html>
