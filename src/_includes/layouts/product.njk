{% extends "layouts/base.njk" %}
{% import "partials/ui.njk" as ui %}
{% block main %}
{%- set t = site[lang] -%}
{%- set cat = categoryId | category -%}
{%- set langProducts = collections.product | byLang(lang) -%}
{#- H1 của trang là tên sản phẩm, nên tên danh mục trên banner không dùng thẻ heading -#}
{{ ui.banner(categoryId, false) }}
{{ ui.path(categoryId, lang) }}
<section class="wrap n-products">
{{ ui.productsSidebar(lang, categoryId, t, langProducts | pickByIds(hot[lang])) }}
<div class="products-right">
<div class="products-detail">
<div class="box1 wow fadeInUp" data-wow-delay="0.15s">
<div class="left">
<div class="bigImg"><img src="{{ images[0] if images else thumb }}" alt="{{ title }}" fetchpriority="high"></div>
<div class="smImg">
<div class="swiper-button-prev"></div>
<div class="swiper-container">
<ul class="swiper-wrapper">
{%- for image in images %}
<li class="swiper-slide"><img src="{{ image }}" alt="{{ title }} – {{ loop.index }}"/></li>
{%- endfor %}
</ul>
</div>
<div class="swiper-button-next"></div>
</div>
</div>
<div class="right">
<h1 class="title">{{ title }}</h1>
<div class="typename">{{ t.product.categoryLabel }} <a href="{{ cat.url }}">{{ cat.name }}</a></div>
<div class="summary">
<div class="t">{{ t.product.summary }}</div>
<div class="c">{{ summary | safe }}</div>
</div>
<div class="button">
<div class="t">{{ t.product.interested }}</div>
<div class="c">
<ul>
<li><a href="tel:{{ site.telephone | replace(' ', '') }}">{{ t.product.hotline }} {{ site.hotline }} <i class="icon iconfont icon-xiangyoujiantou"></i></a></li>
<li><a href="{{ cat.url }}">{{ t.product.backList }} <i class="icon iconfont icon-xiangyoujiantou"></i></a></li>
</ul>
</div>
</div>
</div>
</div>
<div class="box4 wow fadeInUp" data-wow-delay="0.3s">
<div class="title">{{ t.product.detail }}</div>
<div class="content">{{ content | lazyImages | safe }}</div>
</div>
<div class="box2 wow fadeInUp" data-wow-delay="0.45s">
<div class="title">{{ t.product.related }}</div>
{#- .content giữ viền + lề trong; khung Swiper nằm bên trong để vùng cắt sát mép thẻ (không lộ thẻ bên cạnh trong phần lề) -#}
<div class="content">
<div class="swiper-container">
<ul class="swiper-wrapper">
{#- 8 sản phẩm gần nhất với sản phẩm đang xem (không gồm chính nó): xem relatedProducts trong eleventy.config.js -#}
{%- for product in collections.product | relatedProducts(id, lang, 8) %}
<li class="swiper-slide">
<a title="{{ product.data.title }}" href="{{ product.url }}">
<div class="image"><img src="{{ product.data.thumb }}" alt="{{ product.data.title }}"></div>
<div class="name">{{ product.data.title }}</div>
<div class="more">
<span>{{ t.product.relatedMore }} <i class="icon iconfont icon-xiangyoujiantou"></i></span>
</div>
</a>
</li>
{%- endfor %}
</ul>
<div class="swiper-pagination"></div>
</div>
</div>
</div>
</div>
</div>
</section>
{% endblock %}
{% block scripts %}
<script>
$(function(){
{{ ui.hotSwiperScript() }}
var Bswiper = new Swiper('.smImg .swiper-container', {
slidesPerView : 4,
spaceBetween : 10,
centeredSlides : true,
centeredSlidesBounds: true,
normalizeSlideIndex: false,
slideToClickedSlide: true,
navigation: {
nextEl: '.smImg .swiper-button-next',
prevEl: '.smImg .swiper-button-prev'
},
on: {
init:function(swiper){
var Img = $('.smImg li').eq(0).find('img').attr('src');
$('.bigImg img').attr('src', Img);
},
slideChange: function(){
var index = this.activeIndex;
var Img = $('.smImg li').eq(index).find('img').attr('src');
$('.bigImg img').attr('src', Img);
},
resize: function(){
Bswiper.updateSize();
}
}
});
var RSwiper = new Swiper('.products-detail .box2 .swiper-container',{
slidesPerView: 4,
slidesPerGroup: 4,
spaceBetween: 10,
pagination: {
clickable: true,
el: '.products-detail .box2 .swiper-pagination'
},
breakpoints: {
993: {
slidesPerView: 4,
slidesPerGroup: 4
},
768: {
slidesPerView: 3,
slidesPerGroup: 3
},
0: {
slidesPerView: 2,
slidesPerGroup: 2
}
},
on: {
resize: function(){
RSwiper.updateSize();
}
}
});
})
</script>
{% endblock %}
