{
  "name": "kewaqi-site",
  "private": true,
  "type": "module",
  "description": "Website tĩnh kewaqi.com — giữ giao diện cũ, dựng bằng Eleventy",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "check": "node tools/check-links.mjs",
